<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>eplansys_rmf_demo</name>
  <version>0.1.0</version>
  <description>
    The site survey of eplansys, run over an Open-RMF fleet.
  </description>
  <maintainer email="hanielulises@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>eplansys_rmf_bridge</exec_depend>
  <exec_depend>eplansys_demo</exec_depend>
  <exec_depend>plansys2_bringup</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
