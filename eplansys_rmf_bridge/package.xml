<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>eplansys_rmf_bridge</name>
  <version>0.1.0</version>
  <description>
    PlanSys2 performers that execute epistemic actions over an Open-RMF fleet,
    and carry what the robots observed back into the epistemic state.
  </description>
  <maintainer email="hanielulises@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <build_depend>plansys2_executor</build_depend>
  <exec_depend>plansys2_executor</exec_depend>
  <build_depend>plansys2_msgs</build_depend>
  <exec_depend>plansys2_msgs</exec_depend>
  <depend>rmf_task_msgs</depend>
  <depend>rmf_fleet_msgs</depend>
  <depend>libwebsocketpp-dev</depend>
  <depend>libboost-system-dev</depend>
  <depend>nlohmann-json-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
