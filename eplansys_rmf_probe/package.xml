<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>eplansys_rmf_probe</name>
  <version>0.1.0</version>
  <description>
    Diagnostic probes for the ePlanSys to Open-RMF bridge. One submits a task
    pinned to a named robot; the other stands in for the api server and reports
    what comes back over the websocket.
  </description>
  <maintainer email="hanielulises@gmail.com">Haniel Ulises</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rmf_task_msgs</depend>
  <depend>rmf_websocket</depend>
  <depend>nlohmann-json-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
